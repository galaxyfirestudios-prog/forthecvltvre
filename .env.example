# Safe to expose only in the frontend build; this is a Paystack PUBLIC key.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_PUBLIC_KEY

# NEVER put this in VITE_ variables or commit it to GitHub.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY

# Supabase server-side credentials.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Central Galaxy Fire sale notifications.
# If SALES_NOTIFICATION_EMAIL is omitted, the code defaults to galaxyfirestudios@gmail.com.
SALES_NOTIFICATION_EMAIL=galaxyfirestudios@gmail.com

# Resend is the outbound email provider used by the server.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Galaxy Fire Studios <verified-sender@yourdomain.com>
FOR_THE_CULTURE_SUBMISSION_EMAIL=fortheculture184@gmail.com

# FOR THE CULTURE Editorial Engine — server only.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
EDITORIAL_MODEL=gemini-3.5-flash-lite
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional separate secret for manually triggering the editorial scanner.
EDITORIAL_CRON_SECRET=REPLACE_WITH_A_SECOND_LONG_RANDOM_SECRET

# Optional editorial source/tuning overrides.
EDITORIAL_NATIVE_FEED=https://thenativemag.com/feed/
EDITORIAL_NATIVE_MUSIC_FEED=https://thenativemag.com/category/music/feed/
EDITORIAL_GUARDIAN_FEED=https://guardian.ng/feed/
EDITORIAL_SOURCE_ITEMS=24
EDITORIAL_IMAGE_FETCH_TIMEOUT_MS=5000
EDITORIAL_GEMINI_TIMEOUT_MS=20000
EDITORIAL_MAX_STORIES_PER_SCAN=4
EDITORIAL_MAX_AGE_HOURS=96

# GitHub Pages note: the public site reads public/editorial-feed.json.
# The GitHub Actions editorial radar uses SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and GEMINI_API_KEY as repository secrets.

# FOR THE CULTURE RADIO live stream endpoint (Icecast/Shoutcast/HLS-compatible URL)
VITE_RADIO_STREAM_URL=
